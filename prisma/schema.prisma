model Notification {
  id        String           @id @default(uuid())
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
}

enum NotificationType {
  CARD_INTERACTION
  CONTACT_SHARED
  WALLET_UPDATE
  WALLET_FUNDED
  WALLET_TRANSFER
  CONTACT_SAVED
  MEETING_REQUEST
  APPOINTMENT_BOOKED
}

model SupportRequest {
  id        String    @id @default(uuid())
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subject   String
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CardInteraction {
  id         String    @id @default(uuid())
  user       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  deviceId   String
  method     ScanType
  deviceType String?
  referrer   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

