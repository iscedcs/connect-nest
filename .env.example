PORT=4990
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/connect?schema=public

# Auth & Security
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
AUTH_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3154

# Shared secret with isce-auth for HMAC-SHA256 signing of the
# POST /cp/webhooks/invite-accepted payload (x-webhook-signature header)
AUTH_INVITE_WEBHOOK_SECRET=

# Internal service-to-service secret (shared across all ISCE backends)
INTERNAL_API_KEY=

# Paystack Payments & Webhooks
PAYSTACK_SECRET_KEY=

# Paydestal Payments (Optional / Secondary)
PAYDESTAL_BASE_URL=https://api.paydestal.com/v1
PAYDESTAL_SECRET_KEY=
PAYDESTAL_PUBLIC_KEY=
WEBHOOK_REPUSH=
CREATE_DEDICATED_ACCOUNT=

# Storage (DigitalOcean Spaces / AWS S3)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_BUCKET=isce-connect-files
DO_SPACES_REGION=fra1
# Optional. Overrides the public URL base (e.g. a CDN endpoint).
# Defaults to https://<bucket>.<region>.digitaloceanspaces.com
DO_SPACES_PUBLIC_BASE=

# Alternative AWS S3 (optional fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=isce-connect-files

# Email & Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=LYNCON <notifications@lyncon.app>
APP_URL=https://lyncon.app
# Public base URL of connect-web, no trailing slash. Used for links in emails
# (Connect Plus invites: <CONNECT_WEB_URL>/cp/invites/accept?...).
CONNECT_WEB_URL=http://localhost:3154

# SMS (Termii)
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Health monitoring
HEALTH_ALERT_EMAILS=

# Sentry Error Tracking
SENTRY_DSN=
