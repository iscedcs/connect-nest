enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ScanType {
  TAP
  SCAN
}

// Profile Contact (phone numbers for profile owner)
model ProfileContact {
  id           String    @id @default(uuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  label        String?
  phone_number String
  is_primary   Boolean   @default(false)
  is_visible   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// Links
model Link {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  title      String
  url        String
  image      String?
  order      Int?
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Videos
model Video {
  id          String    @id @default(uuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  platform    String
  url         String
  thumbnail   String?
  is_featured Boolean   @default(false)
  is_visible  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// Meeting Links
model MeetingLink {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  provider   String
  url        String
  label      String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Appointment Links
model AppointmentLink {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  provider   String
  url        String
  label      String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Spotify Items
model SpotifyItem {
  id           String    @id @default(uuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  type         String
  external_url String
  title        String
  is_visible   Boolean   @default(true)
  order        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// File Items
model FileItem {
  id          String    @id @default(uuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  filename    String
  storage_key String
  media_type  String
  size_bytes  Int
  checksum    String?
  spaces_url  String
  is_visible  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// Forms
model Form {
  id          String       @id @default(uuid())
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  description String?
  form_type   String
  template_id String?
  status      FormStatus   @default(DRAFT)
  fields      Json
  form_url    String?
  is_visible  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  submissions Submission[]
}

enum FormStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// Form Templates
model FormTemplate {
  id             String   @id @default(uuid())
  name           String
  category       String
  description    String?
  preview_fields Json
  is_system      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Form Submissions
model Submission {
  id           String    @id @default(uuid())
  form         Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId       String
  submitted_at DateTime  @default(now())
  answers      Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// Wallets
model Wallet {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  network    String
  address    String
  label      String?
  ens        String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Connect Page Configuration
model ConnectConfig {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String   @unique
  modules   Json
  theme     Json?
  branding  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Device-Profile Binding
// Maps a physical device (NFC card/tag) to a specific profile.
// One device can only be linked to one profile at a time.
// Unlinking + relinking is supported — devices can be moved between profiles.
model DeviceProfile {
  id        String   @id @default(uuid())
  deviceId  String   @unique // productId from isce-auth Device model
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fcmToken  String? // Firebase Cloud Messaging token for push notifications
  linkedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ─── Artisan Enums ────────────────────────────────────────

enum ArtisanStatus {
  PENDING_REVIEW // Awaiting admin approval (when manual review enabled)
  ACTIVE // Listed in directory, can receive bookings & payments
  SUSPENDED // Temporarily disabled by admin
  DEACTIVATED // Self-deactivated by user
}

enum BookingStatus {
  PENDING // Customer submitted, artisan hasn't responded
  CONFIRMED // Artisan accepted
  IN_PROGRESS // Service is being delivered
  COMPLETED // Service finished, payment settled
  CANCELLED // Cancelled by either party
  NO_SHOW // Customer didn't show up
}

enum PromotionType {
  SPONSORED // Top carousel placement in directory
  BOOST // Temporary search ranking boost (24-48 hrs)
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Booking Thread Enums ─────────────────────────────────

enum ThreadStatus {
  OPEN // Inquiry sent, conversation ongoing
  PROPOSAL_SENT // Artisan sent a structured proposal
  BOOKED // Proposal accepted → Booking created
  CLOSED // Manually closed by either party, or expired
}

enum ThreadMessageType {
  TEXT // Free-form message
  PROPOSAL // Structured proposal (price, date, time, etc.)
  SYSTEM // Automated messages ("Booking confirmed", etc.)
}

enum SenderRole {
  CLIENT
  ARTISAN
}

enum PaymentMethod {
  WALLET // In-app wallet escrow
  OFFLINE // Cash, bank transfer, etc.
  NONE // No payment attached yet
}

enum PaymentTiming {
  UPFRONT // Pay before work starts
  ON_COMPLETION // Pay after work is done
}

enum PaymentDisputedBy {
  CLIENT
  ARTISAN
}

// ─── Artisan Core ─────────────────────────────────────────

model Artisan {
  id        String  @id @default(uuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique
  userId    String // Denormalized from profile for fast queries

  // Artisan-specific fields
  bio            String? // Artisan pitch (separate from profile.description)
  status         ArtisanStatus @default(PENDING_REVIEW)
  customCategory String? // Free-text when "Others" category is selected

  // Verification
  termsAcceptedAt DateTime?
  activatedAt     DateTime? // When status changed to ACTIVE
  suspendedReason String? // Admin reason for suspension

  // Stats (denormalized for directory performance)
  averageRating Decimal @default(0) @db.Decimal(3, 2) // 0.00 - 5.00
  totalReviews  Int     @default(0)
  totalBookings Int     @default(0)
  totalEarnings Decimal @default(0) @db.Decimal(18, 4) // Lifetime earnings via platform

  // Working hours: JSON array of { day: 0-6, open: "09:00", close: "17:00", isOpen: boolean }
  workingHours Json?

  // NEW Fields for Talent Sourcing
  openToWork        Boolean     @default(true)
  desiredJobTypes   JobType[]   // What kind of work they want
  desiredWorkModels WorkModel[] // Remote, On-site, etc.
  skills            String[]    // Array of skill tags for boolean search

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  categories ArtisanCategoryMap[]
  services   ArtisanService[]
  portfolio  PortfolioItem[]
  bookings   Booking[]
  reviews    Review[]
  promotions Promotion[]
  threads    BookingThread[]
  applications CpJobApplication[]
  savedBy      CpSavedTalent[]

  @@index([userId])
  @@index([status])
  @@index([averageRating])
  @@index([createdAt])
}

// ─── Categories ───────────────────────────────────────────

model ArtisanCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique // URL-safe: "beauty-grooming"
  icon        String? // Emoji or icon identifier
  description String?
  order       Int      @default(0) // Display order in UI
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artisans ArtisanCategoryMap[]

  @@index([slug])
  @@index([isActive, order])
}

// Many-to-many: an artisan can have 1–3 categories
model ArtisanCategoryMap {
  id         String          @id @default(uuid())
  artisan    Artisan         @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId  String
  category   ArtisanCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  isPrimary  Boolean         @default(false) // First selected category

  @@unique([artisanId, categoryId])
  @@index([categoryId])
}

// ─── Services ─────────────────────────────────────────────

model ArtisanService {
  id          String    @id @default(uuid())
  artisan     Artisan   @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId   String
  name        String
  description String?
  price       Decimal?  @db.Decimal(18, 4)
  currency    String    @default("NGN")
  duration    Int? // Duration in minutes (optional)
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  bookings Booking[]
  threads  BookingThread[]

  @@index([artisanId])
  @@index([isActive])
}

// ─── Portfolio ────────────────────────────────────────────

model PortfolioItem {
  id        String    @id @default(uuid())
  artisan   Artisan   @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId String
  type      String    @default("image") // "image" | "video" | "link"
  url       String // DO Spaces URL or external link
  thumbnail String? // For videos — auto-generated or uploaded
  caption   String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([artisanId])
}

// ─── Booking Threads (Conversation) ──────────────────────

model BookingThread {
  id              String          @id @default(uuid())
  artisan         Artisan         @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId       String
  service         ArtisanService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId       String? // Optional: which service the inquiry is about
  clientUserId    String // The customer who initiated
  clientProfileId String? // Customer's Connect profile ID
  clientName      String? // Snapshot at inquiry time
  clientPhone     String?

  status    ThreadStatus @default(OPEN)
  bookingId String?      @unique // Set when proposal is accepted → Booking created
  booking   Booking?     @relation("ThreadBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime  @default(now())
  closedAt      DateTime?
  closedBy      String? // "client" | "artisan" | "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ThreadMessage[]

  @@index([artisanId])
  @@index([clientUserId])
  @@index([status])
  @@index([lastMessageAt])
}

model ThreadMessage {
  id           String        @id @default(uuid())
  thread       BookingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId     String
  senderUserId String
  senderRole   SenderRole

  type         ThreadMessageType @default(TEXT)
  content      String // Text body
  proposalData Json? // For PROPOSAL type: { serviceId, price, currency, date, time, duration, paymentPreference, paymentTiming, note }

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderUserId])
  @@index([createdAt])
}

// ─── Bookings ─────────────────────────────────────────────

model Booking {
  id                String          @id @default(uuid())
  artisan           Artisan         @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId         String
  service           ArtisanService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId         String?
  customerUserId    String // The user who booked (from JWT)
  customerProfileId String? // Optional: customer's profile ID
  customerName      String? // Snapshot at booking time
  customerPhone     String?

  // Scheduling
  scheduledDate DateTime?
  scheduledTime String? // "14:00" — separate from date for flexibility
  duration      Int? // Minutes, copied from service or custom

  // Pricing
  agreedPrice      Decimal? @db.Decimal(18, 4)
  currency         String   @default("NGN")
  commissionAmount Decimal? @db.Decimal(18, 4) // Platform commission

  // Payment tracking
  paymentMethod    PaymentMethod @default(WALLET)
  paymentTiming    PaymentTiming @default(ON_COMPLETION)
  paymentReference String? // wallet-nest escrow ID for WALLET payments
  isPaid           Boolean       @default(false)
  paidAt           DateTime?

  // Dual payment confirmation (for OFFLINE payments)
  clientPaymentConfirmed    Boolean   @default(false)
  clientPaymentConfirmedAt  DateTime?
  artisanPaymentConfirmed   Boolean   @default(false)
  artisanPaymentConfirmedAt DateTime?

  // Payment disputes
  paymentDisputed      Boolean            @default(false)
  paymentDisputeReason String?
  paymentDisputedAt    DateTime?
  paymentDisputedBy    PaymentDisputedBy?

  status             BookingStatus @default(PENDING)
  note               String? // Customer note to artisan
  cancelledBy        String? // "artisan" | "customer"
  cancellationReason String?
  cancelledAt        DateTime?
  startedAt          DateTime? // When artisan started work
  completedAt        DateTime? // When artisan marked complete

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  review Review?
  thread BookingThread? @relation("ThreadBooking")

  @@index([artisanId])
  @@index([customerUserId])
  @@index([status])
  @@index([scheduledDate])
}

// ─── Reviews ──────────────────────────────────────────────

model Review {
  id             String   @id @default(uuid())
  artisan        Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId      String
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId      String?  @unique // One review per booking
  reviewerUserId String // The customer who left the review
  reviewerName   String? // Snapshot

  rating  Int // 1–5 stars
  comment String?

  // Payment verification: review only allowed if reviewer has completed booking/payment
  paymentReference String? // wallet-nest transaction reference that validates eligibility

  isVisible Boolean   @default(true) // Admin can hide inappropriate reviews
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([artisanId])
  @@index([reviewerUserId])
  @@index([rating])
}

// ─── Promotions ───────────────────────────────────────────

model Promotion {
  id        String          @id @default(uuid())
  artisan   Artisan         @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId String
  type      PromotionType
  status    PromotionStatus @default(ACTIVE)

  // Payment
  amount           Decimal @db.Decimal(18, 4)
  currency         String  @default("NGN")
  paymentReference String? // wallet-nest transaction reference

  startsAt DateTime @default(now())
  endsAt   DateTime // When the promotion expires
  metadata Json? // Extra config (e.g., boost intensity)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanId])
  @@index([status])
  @@index([type, status])
  @@index([endsAt])
}

// ─── Platform Settings (singleton) ────────────────────────

model PlatformSetting {
  id                    String   @id @default("default")
  artisanAutoApproval   Boolean  @default(true) // true = auto-list, false = manual review
  artisanCommissionRate Decimal  @default(0.025) @db.Decimal(5, 4) // 2.5% default
  sponsoredPriceDaily   Decimal  @default(500) @db.Decimal(18, 4) // ₦500/day
  boostPriceDaily       Decimal  @default(200) @db.Decimal(18, 4) // ₦200/day
  minPortfolioItems     Int      @default(2)
  maxCategories         Int      @default(3)
  updatedAt             DateTime @updatedAt
}

