enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ScanType {
  TAP
  SCAN
}

// Profile Contact (phone numbers for profile owner)
model ProfileContact {
  id           String    @id @default(uuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  label        String?
  phone_number String
  is_primary   Boolean   @default(false)
  is_visible   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// Links
model Link {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  title      String
  url        String
  image      String?
  order      Int?
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Videos
model Video {
  id          String    @id @default(uuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  platform    String
  url         String
  thumbnail   String?
  is_featured Boolean   @default(false)
  is_visible  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// Meeting Links
model MeetingLink {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  provider   String
  url        String
  label      String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Appointment Links
model AppointmentLink {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  provider   String
  url        String
  label      String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Spotify Items
model SpotifyItem {
  id           String    @id @default(uuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  type         String
  external_url String
  title        String
  is_visible   Boolean   @default(true)
  order        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// File Items
model FileItem {
  id          String    @id @default(uuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  filename    String
  storage_key String
  media_type  String
  size_bytes  Int
  checksum    String?
  spaces_url  String
  is_visible  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// Forms
model Form {
  id          String       @id @default(uuid())
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  description String?
  form_type   String
  template_id String?
  status      FormStatus   @default(DRAFT)
  fields      Json
  form_url    String?
  is_visible  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  submissions Submission[]
}

enum FormStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// Form Templates
model FormTemplate {
  id             String   @id @default(uuid())
  name           String
  category       String
  description    String?
  preview_fields Json
  is_system      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Form Submissions
model Submission {
  id           String    @id @default(uuid())
  form         Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId       String
  submitted_at DateTime  @default(now())
  answers      Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

// Wallets
model Wallet {
  id         String    @id @default(uuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  network    String
  address    String
  label      String?
  ens        String?
  is_default Boolean   @default(false)
  is_visible Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// Connect Page Configuration
model ConnectConfig {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String   @unique
  modules   Json
  theme     Json?
  branding  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Device-Profile Binding
// Maps a physical device (NFC card/tag) to a specific profile.
// One device can only be linked to one profile at a time.
// Unlinking + relinking is supported — devices can be moved between profiles.
model DeviceProfile {
  id        String   @id @default(uuid())
  deviceId  String   @unique // productId from isce-auth Device model
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fcmToken  String? // Firebase Cloud Messaging token for push notifications
  linkedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}
